# 复制本文件为 .env 并填入真实值。.env 已被 gitignore，绝不提交。
# 获取 API key：https://platform.xiaomimimo.com/ （OpenAI 兼容协议）

# LLM API（当前默认：小米 MiMo Token Plan）
# 留空也能启动：本地词库、复习、备份等非 AI 功能可用，AI 操作会提示未配置（HTTP 503）。
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 学习时区（IANA 名称，默认 Asia/Shanghai）
LEARNING_TIMEZONE=Asia/Shanghai

# 数据文件位置（默认 data/english_coach.db，可自定义）
DATABASE_URL=sqlite:///./data/english_coach.db

# 旧版 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 已不再读取。
# 如仍存在，应用会报错并提示迁移到 LLM_API_KEY / LLM_BASE_URL；请勿把旧密钥
# 直接套用到不同供应商地址。
# 功能回退：false 隐藏延迟回测入口，保留历史、排期和 V3 兼容
DELAYED_RECALL_ENABLED=true

# 功能回退：false 隐藏学习建议，保留练习轮次、证据、排期和 V3 兼容
LEARNING_ADVICE_ENABLED=true

# 读后检查功能回退；已有结果、原文与 V3 仍可读取
STORY_CHECKS_ENABLED=true

# false 仅关闭自我介绍/问路的新轮次；买饮品与已有轮次、V3 历史仍可用
SCENE_EXPANSIONS_ENABLED=true

# false 仅关闭模型角色增强；核对模板、已存答案/反馈、V3 继续可用
SCENE_FEEDBACK_ENABLED=true

# false 使用有标注的默认时间估算；保留主动时长、学习事件与 V3 适配
PERSONAL_ESTIMATES_ENABLED=true

# false 隐藏恢复学习推荐；已冻结轮次、历史、FSRS 和 V3 继续保留
RECOVERY_MODE_ENABLED=true
