# 复制本文件为 .env 并填入真实值。.env 已被 gitignore，绝不提交。
# 获取 API key：https://platform.xiaomimimo.com/ （OpenAI 兼容协议）

# LLM API（当前默认：小米 MiMo Token Plan）
# 留空也能启动：本地词库、复习、备份等非 AI 功能可用，AI 操作会提示未配置（HTTP 503）。
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 学习时区（IANA 名称，默认 Asia/Shanghai）
LEARNING_TIMEZONE=Asia/Shanghai

# 数据文件位置（默认 data/english_coach.db，可自定义）
DATABASE_URL=sqlite:///./data/english_coach.db

# 旧版 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 已不再读取。
# 如仍存在，应用会报错并提示迁移到 LLM_API_KEY / LLM_BASE_URL；请勿把旧密钥
# 直接套用到不同供应商地址。
