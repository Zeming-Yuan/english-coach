{
  "name": "englishcoach",
  "version": "2.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs'),p='../app/static/assets/';fs.readdirSync(p).filter(f=>f.startsWith('index-')&&f.endsWith('.js')).forEach(f=>fs.unlinkSync(p+f))\"",
    "build": "npm run clean && vite build",
    "preview": "vite preview",
    "test:e2e": "node ../e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource/tinos": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.0"
  }
}
